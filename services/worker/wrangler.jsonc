{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ermolov-leads-api",
  "account_id": "52a5f4d5c9b84f6ab34ad87c1651f61d",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ermolov.dev/api/*", "zone_name": "ermolov.dev" },
    { "pattern": "www.ermolov.dev/api/*", "zone_name": "ermolov.dev" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://ermolov.dev,https://www.ermolov.dev",
    "TURNSTILE_HOSTNAMES": "ermolov.dev,www.ermolov.dev"
  },
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "RELAY_TOKEN"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ermolov-leads",
    "database_id": "825db71d-c29a-4bc4-99de-71b4a59122b4",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "LEAD_RATE_LIMITER",
    "namespace_id": "2026092101",
    "simple": { "limit": 5, "period": 60 }
  }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
