{
  "name": "ermolov.dev static site security headers",
  "kind": "zone",
  "phase": "http_response_headers_transform",
  "rules": [
    {
      "ref": "ermolov_static_security",
      "description": "Protect static site from framing, MIME sniffing and unsafe base/form targets",
      "expression": "(http.host in {\"ermolov.dev\" \"www.ermolov.dev\"}) and not starts_with(http.request.uri.path, \"/api/\") and not starts_with(http.request.uri.path, \"/cdn-cgi/\")",
      "action": "rewrite",
      "action_parameters": {
        "headers": {
          "content-security-policy": {
            "operation": "set",
            "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
          },
          "x-content-type-options": {
            "operation": "set",
            "value": "nosniff"
          },
          "x-frame-options": {
            "operation": "set",
            "value": "DENY"
          },
          "referrer-policy": {
            "operation": "set",
            "value": "strict-origin-when-cross-origin"
          },
          "permissions-policy": {
            "operation": "set",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          "strict-transport-security": {
            "operation": "set",
            "value": "max-age=31536000"
          },
          "x-do-app-origin": {
            "operation": "remove"
          },
          "x-rgw-object-type": {
            "operation": "remove"
          }
        }
      },
      "enabled": true
    }
  ]
}
